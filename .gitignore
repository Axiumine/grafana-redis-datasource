# Modified in 2026 by Axiumine, from the original in
# RedisGrafana/grafana-redis-datasource at 09df07a. See NOTICE and CHANGELOG.md.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# Compiled binary addons (https://nodejs.org/api/addons.html)
dist/
artifacts/
node_modules/
work/
ci/
e2e-results/
vendor/

# Editor
.idea
.DS_Store

# Caches
.eslintcache

# Secrets. QODANA_TOKEN and GRAFANA_ACCESS_POLICY_TOKEN live here, and this
# repository is public. A global core.excludesFile is not enough: it does not
# travel with a clone, so the rule has to be in the repository itself.
.env
.env.*
!.env.example

# Qodana. The CLI writes its cache and its results under the project root; the
# coverage the linters produce through their bootstrap lands in coverage/, which
# is already ignored above.
.qodana/
qodana.sarif.json
