# Runs Qodana over the working tree before a commit is created, and enforces the
# quality gate declared in qodana-go.yaml and qodana-js.yaml: no CRITICAL and no
# HIGH problems, 100% test coverage on changed lines, and a measured overall
# floor — 99% for the Go backend, 100% for the TypeScript frontend.
#
# One Qodana run analyses one linter image, so the Go backend and the TypeScript
# frontend are two runs. Both need an Ultimate or Ultimate Plus licence —
# qodana-go and qodana-js have no Community edition — which the CLI verifies
# against Qodana Cloud using QODANA_TOKEN.
#
# Escape hatches:
#   SKIP_QODANA=1 git commit ...     skip this hook entirely
#   QODANA_LINTERS=go git commit ... run only one of: go, js, "go js"
#   QODANA_REQUIRED=1                turn a missing token into a hard failure
#                                    instead of a skip

# The linter caches go outside the working tree on purpose. Qodana mounts the
# cache directory as well as the project, and Go's module cache lives inside it,
# so a cache under .qodana/ would put the whole downloaded toolchain and every
# dependency's source inside the analysed project: indexing crawls through the
# standard library's own _asm modules and the run never finishes. Only the
# results directory, which holds logs, stays in the repository, and .gitignore
# already covers it.
CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}/qodana-precommit

set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

if [ "${SKIP_QODANA:-0}" = "1" ]; then
  echo "  Qodana skipped (SKIP_QODANA=1)."
  exit 0
fi

LINTERS=${QODANA_LINTERS:-"go js"}

# Load the tokens from the untracked .env, without printing them. `set -a`
# exports every assignment the file makes, which is how the CLI receives
# QODANA_TOKEN.
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./.env
  set +a
fi

fail() {
  echo ""
  echo "  $1"
  echo ""
  exit 1
}

if ! command -v qodana >/dev/null 2>&1; then
  fail "Qodana CLI not found. Install it from https://github.com/JetBrains/qodana-cli
  or commit with SKIP_QODANA=1 if you cannot."
fi

if ! docker info >/dev/null 2>&1; then
  fail "Qodana runs its linters in Docker, and the daemon is not reachable.
  Start Docker, or commit with SKIP_QODANA=1."
fi

if [ -z "${QODANA_TOKEN:-}" ]; then
  if [ "${QODANA_REQUIRED:-0}" = "1" ]; then
    fail "QODANA_TOKEN is not set, and QODANA_REQUIRED=1.
  qodana-go and qodana-js have no Community edition, so neither linter can
  start without a licence. Put the token in .env, which is gitignored."
  fi
  echo ""
  echo "  Qodana skipped: QODANA_TOKEN is not set."
  echo "  qodana-go and qodana-js have no Community edition, so neither linter"
  echo "  runs without a licence. Put the token in .env to enable this hook."
  echo ""
  exit 0
fi

# Qodana mounts the project at /data/project and runs git there. In this
# checkout `.git` is a file pointing at the umbrella repository's
# .git/modules/grafana-redis-datasource, which lives outside the mount, so git
# inside the container reports "fatal: not a git repository" and Qodana loses
# the history it attributes fresh code with. Mounting the real git directory and
# naming it through GIT_DIR restores that. GIT_WORK_TREE has to come with it:
# the submodule's config sets core.worktree to a path relative to the git
# directory, which resolves to the wrong place under the container's layout, and
# the environment variable is what overrides it.
GIT_MOUNT=()
if [ ! -d .git ]; then
  GIT_DIR_HOST=$(git rev-parse --absolute-git-dir)
  GIT_MOUNT=(
    --volume "$GIT_DIR_HOST:/data/git-dir"
    --env GIT_DIR=/data/git-dir
    --env GIT_WORK_TREE=/data/project
  )
fi

STATUS=0

for LINTER in $LINTERS; do
  CONFIG="qodana-$LINTER.yaml"
  if [ ! -f "$CONFIG" ]; then
    fail "No $CONFIG in the repository root."
  fi

  echo ""
  echo "  Qodana: scanning with $CONFIG ..."
  echo ""

  # --save-report=false keeps the hook to the analysis and the quality gate; the
  # HTML report is what CI and Qodana Cloud are for. The CLI exits non-zero when
  # a failureConditions threshold is breached, which is what gates the commit.
  if ! qodana scan \
    --config "$CONFIG" \
    --results-dir ".qodana/$LINTER" \
    --cache-dir "$CACHE_HOME/$LINTER" \
    --save-report=false \
    --print-problems \
    "${GIT_MOUNT[@]}"; then
    STATUS=1
    echo ""
    echo "  Qodana quality gate failed for $CONFIG."
  fi
done

if [ "$STATUS" -ne 0 ]; then
  echo ""
  echo "  COMMIT REJECTED BY QODANA"
  echo ""
  echo "  The gate is: 0 CRITICAL, 0 HIGH, 100% coverage on changed lines, and"
  echo "  the overall floor each config declares. Fix the problems above, or"
  echo "  commit with SKIP_QODANA=1 if the failure is not yours to fix here."
  echo ""
  exit 1
fi

echo ""
echo "  Qodana: quality gate passed."
echo ""
exit 0
